ount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"108","messages":"109","suppressedMessages":"110","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\index.js",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\App.js",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\Layout.jsx",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\pages\\Home.jsx",["111","112","113","114"],[],"import Brands from \"../components/Brands\";\nimport Projects from \"../components/Projects\";\nimport Testimonial from \"../components/Testimonial\";\nimport Hero from \"../components/Hero\";\nimport About from \"../components/About\";\nimport Service from \"../components/Service\";\nimport HomePagdData from \"../data/HomePagdData.json\";\nimport Experience from \"../components/Experience\";\nimport Contact from \"../components/Contact\";\n\nexport default function Home() {\n  const {\n    hero,\n    socialBtns,\n    brands,\n    about,\n    projects,\n    service,\n    experience,\n    testimonial,\n    contact,\n  } = HomePagdData;\n  return (\n    <>\n      <Hero data={hero} socialData={socialBtns} />\n      <About data={about} />\n      <Projects data={projects} />\n      <Service data={service} />\n      <Experience data={experience} />\n      <Contact data={contact} socialData={socialBtns} />\n    </>\n  );\n}\n","D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\Footer.jsx",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\Header.jsx",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\CustomCursor.jsx",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\Projects.jsx",["115","116"],[],"import { Icon } from '@iconify/react';\nimport React, { useState } from 'react';\nimport SectionHeading from './SectionHeading';\nimport Slider from 'react-slick';\nimport Modal from './Modal';\n\nexport default function Projects({ data }) {\n  const [modal, setModal] = useState(false);\n  const [modalType, setModalType] = useState('image');\n  const [modalData, setModalData] = useState({});\n  const { sectionHeading, allProjects } = data;\n  const handelProjectDetails = (item, itemType) => {\n    if (itemType === 'image') {\n      setModalData(item);\n    } else {\n      setModalData(item);\n    }\n    setModalType(itemType);\n\n    setModal(!modal);\n    console.log(modalType);\n  };\n\n  var settings = {\n    dots: true,\n    arrows: false,\n    infinite: true,\n    autoplay: false,\n    autoplaySpeed: 4000,\n    speed: 1000,\n    slidesToShow: 1,\n    slidesToScroll: 1,\n    initialSlide: 0,\n    variableWidth: true,\n  };\n\n  return (\n    <>\n      <section className=\"project-section section gray-bg\" id=\"project\">\n        <div className=\"container\">\n          <SectionHeading\n            miniTitle={sectionHeading.miniTitle}\n            title={sectionHeading.title}\n          />\n          <div\n            className=\"row gy-4\"\n            data-aos=\"fade\"\n            data-aos-duration=\"1200\"\n            data-aos-delay=\"400\"\n          >\n            {allProjects?.map((item, index) => (\n              <div key={index} className=\"col-md-6 col-lg-4\">\n                <div className=\"project-box h-100 d-flex flex-column\">\n                  <div className=\"project-media\">\n                    <img src={item.thumbUrl} alt=\"Thumb\" className=\"w-100\" />\n                    <span\n                      className=\"gallery-link\"\n                      onClick={() => handelProjectDetails(item, 'image')}\n                    >\n                      <i>\n                        <Icon icon=\"bi:plus\" />\n                      </i>\n                    </span>\n                  </div>\n                  <div className=\"project-body flex-grow-1 d-flex flex-column justify-content-between pt-3\">\n                    <div className=\"text w-100 mb-3 pe-0\">\n                      <h5>{item.title}</h5>\n                      <span>{item.subTitle}</span>\n                    </div>\n                    <div className=\"d-flex justify-content-between w-100 align-items-center\">\n                      <a \n                        href={item.details?.url || \"#\"} \n                        target=\"_blank\" \n                        rel=\"noreferrer\" \n                        className=\"px-btn px-btn-sm\" \n                        style={{ padding: '8px 20px', fontSize: '14px', borderRadius: '4px' }}\n                      >\n                        See Demo\n                      </a>\n                      <div className=\"link mx-0 w-auto\">\n                        <span\n                          className=\"p-link\"\n                          onClick={() => handelProjectDetails(item, 'details')}\n                        >\n                          <Icon icon=\"bi:arrow-right\" />\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      {modal && (\n        <div className=\"mfp-wrap\">\n          <div className=\"mfp-container\">\n            <div className=\"mfp-bg\" onClick={() => setModal(!modal)}></div>\n            <div className=\"mfp-content\">\n              <button\n                type=\"button\"\n                className=\"mfp-close\"\n                onClick={() => setModal(!modal)}\n              >\n                ×\n              </button>\n              {modalType === 'image' ? (\n                <img src={modalData.thumbUrl} alt=\"Thumbnail\" />\n              ) : (\n                <Modal modalData={modalData} />\n              )}\n            </div>\n          </div>\n        </div>\n      )}\n    </>\n  );\n}\n","D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\Brands.jsx",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\Testimonial.jsx",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\Hero.jsx",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\About.jsx",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\Experience.jsx",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\Contact.jsx",["117"],[],"import React from 'react';\nimport SocialBtns from './SocialBtns';\nimport ContactInfo from './ContactInfo';\nimport ContactForm from './ContactForm';\n\nexport default function Contact({ data, socialData }) {\n  const { sectionHeading, contactImg, contactInfo } = data;\n  return (\n    <section id=\"contactus\" className=\"section contactus-section\">\n      <div className=\"container\">\n        <div className=\"contactus-box rounded oveflow-hidden gray-bg\">\n          <div className=\"row g-0 p-4 p-lg-5\">\n            <div className=\"col-lg-4\" />\n            <div className=\"col-lg-8\">\n              <div\n                className=\"contactus-title\"\n                data-aos=\"fade-left\"\n                data-aos-duration=\"1200\"\n                data-aos-delay=\"200\"\n              >\n                <h5>{sectionHeading.title}</h5>\n                <p className=\"m-0\">{sectionHeading.subTitle}</p>\n              </div>\n            </div>\n          </div>\n          <div className=\"row g-0 contactus-form p-4 p-lg-5 flex-row-reverse\">\n            <div className=\"col-lg-8\">\n              <div className=\"contact-form\">\n                <ContactForm />\n              </div>\n            </div>\n            <div className=\"col-lg-4 pe-md-5\">\n              <ContactInfo contactInfoData={contactInfo} />\n              <SocialBtns socialBtns={socialData} />\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n","D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\Service.jsx",["118"],[],"import { Icon } from '@iconify/react';\nimport React from 'react';\nimport SectionHeading from './SectionHeading';\nimport Ratings from './Ratings';\n\nexport default function Service({ data }) {\n  const { sectionHeading, allService } = data;\n  return (\n    <section className=\"section\" id=\"services\">\n      <div className=\"container\">\n        <SectionHeading\n          miniTitle={sectionHeading.miniTitle}\n          title={sectionHeading.title}\n        />\n        <div className=\"row gy-5\">\n          {allService?.map((item, index) => (\n            <div className=\"col-sm-6 col-lg-3\" key={index}>\n              <div\n                className=\"services-box-icon\"\n                style={{\n                  background: 'rgba(var(--px-theme-rgb), 0.1)',\n                  borderRadius: '10px',\n                  padding: '40px 20px',\n                  textAlign: 'center',\n                  display: 'flex',\n                  flexDirection: 'column',\n                  alignItems: 'center',\n                  height: '100%',\n                  border: '1px solid rgba(255, 255, 255, 0.05)'\n                }}\n                data-aos=\"fade-up\"\n                data-aos-duration=\"1200\"\n                data-aos-delay={index * 100}\n              >\n                <div \n                  className=\"icon-container\" \n                  style={{ \n                    width: '80px', \n                    height: '80px', \n                    display: 'flex', \n                    alignItems: 'center', \n                    justifyContent: 'center', \n                    marginBottom: '20px',\n                    borderRadius: '50%',\n                    background: 'rgba(var(--px-theme-rgb), 0.1)'\n                  }}\n                >\n                  <Icon icon={item.icon} style={{ fontSize: '40px', color: 'var(--px-theme)' }} />\n                </div>\n                <h5 style={{ color: 'var(--px-white)', marginBottom: '15px' }}>{item.title}</h5>\n                <p style={{ color: 'var(--px-white)', opacity: 0.7, fontSize: '14px', lineHeight: '1.6', margin: 0 }}>{item.subTitle}</p>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}\n","D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\Modal.jsx",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\SectionHeading.jsx",[],[],"D:\\All files\\Portfolios\\Other Portfolio Templates\\jenna-personal-portfolio-template-2025-06-15-06-11-26-utc\\jenna-react\\src\\components\\SocialBtns